func TestNewFromInt64(t *testing.T) {
	// Expected values taken from Mono's implementation
	var cases = []struct {
		From     int64
		Expected Decimal
	}{
		{From: -9223372036854775808, Expected: Decimal{flags: 2147483648, high: 0, low: 0, mid: 2147483648}},
		{From: -4611686019501129728, Expected: Decimal{flags: 2147483648, high: 0, low: 1073741824, mid: 1073741824}},
		{From: -2147483648, Expected: Decimal{flags: 2147483648, high: 0, low: 2147483648, mid: 0}},
		{From: -1073758208, Expected: Decimal{flags: 2147483648, high: 0, low: 1073758208, mid: 0}},
		{From: -32768, Expected: Decimal{flags: 2147483648, high: 0, low: 32768, mid: 0}},
		{From: -16448, Expected: Decimal{flags: 2147483648, high: 0, low: 16448, mid: 0}},
		{From: -128, Expected: Decimal{flags: 2147483648, high: 0, low: 128, mid: 0}},
		{From: -64, Expected: Decimal{flags: 2147483648, high: 0, low: 64, mid: 0}},
		{From: 0, Expected: Decimal{flags: 0, high: 0, low: 0, mid: 0}},
		{From: 63, Expected: Decimal{flags: 0, high: 0, low: 63, mid: 0}},
		{From: 127, Expected: Decimal{flags: 0, high: 0, low: 127, mid: 0}},
		{From: 255, Expected: Decimal{flags: 0, high: 0, low: 255, mid: 0}},
		{From: 16447, Expected: Decimal{flags: 0, high: 0, low: 16447, mid: 0}},
		{From: 32767, Expected: Decimal{flags: 0, high: 0, low: 32767, mid: 0}},
		{From: 65535, Expected: Decimal{flags: 0, high: 0, low: 65535, mid: 0}},
		{From: 1073758207, Expected: Decimal{flags: 0, high: 0, low: 1073758207, mid: 0}},
		{From: 2147483647, Expected: Decimal{flags: 0, high: 0, low: 2147483647, mid: 0}},
		{From: 4294967295, Expected: Decimal{flags: 0, high: 0, low: 4294967295, mid: 0}},
		{From: 4611686019501129727, Expected: Decimal{flags: 0, high: 0, low: 1073741823, mid: 1073741824}},
		{From: 9223372036854775807, Expected: Decimal{flags: 0, high: 0, low: 4294967295, mid: 2147483647}},
	}

	for _, z := range cases {
		t.Run(fmt.Sprintf("%d", z.From), func(t *testing.T) {
			actual := NewFromInt64(z.From)
			if z.Expected.flags != actual.flags {
				t.Errorf("incorrect flags: expected %d, actual %d", z.Expected.flags, actual.flags)
			}
			if z.Expected.high != actual.high {
				t.Errorf("incorrect high: expected %d, actual %d", z.Expected.high, actual.high)
			}
			if z.Expected.low != actual.low {
				t.Errorf("incorrect low: expected %d, actual %d", z.Expected.low, actual.low)
			}
			if z.Expected.mid != actual.mid {
				t.Errorf("incorrect mid: expected %d, actual %d", z.Expected.mid, actual.mid)
			}
		})
	}
}

