func TestAbs(t *testing.T) {
	var cases = []struct {
		Name     string
		D        string
		Expected string
	}{
		{Name: "dqabs001", D: "1", Expected: "1"},
		{Name: "dqabs002", D: "-1", Expected: "1"},
		{Name: "dqabs003", D: "1.00", Expected: "1.00"},
		{Name: "dqabs004", D: "-1.00", Expected: "1.00"},
		{Name: "dqabs005", D: "0", Expected: "0"},
		{Name: "dqabs006", D: "0.00", Expected: "0.00"},
		{Name: "dqabs007", D: "00.0", Expected: "0.0"},
		{Name: "dqabs008", D: "00.00", Expected: "0.00"},
		{Name: "dqabs009", D: "00", Expected: "0"},
	}

	for _, z := range cases {
		t.Run(z.Name, func(t *testing.T) {
			var d Decimal
			if assert.NotPanics(t, func() { d = NewFromString(z.D) }) {
				act := d.Abs()
				assert.Equal(t, z.Expected, act.String())
			}
		})
	}
}

func TestMarshalUnmarshal(t *testing.T) {
	var cases = []Decimal{
		Zero,
		One,
		MinusOne,
		MaxValue,
		MinValue,
	}

	for _, z := range cases {
		t.Run(z.String(), func(t *testing.T) {
			b, err := z.MarshalBinary()
			if assert.NoError(t, err) {
				var a = new(Decimal)
				err = a.UnmarshalBinary(b)
				if assert.NoError(t, err) {
					assert.True(t, z.Equal(*a))
				}
			}
		})
	}
}
